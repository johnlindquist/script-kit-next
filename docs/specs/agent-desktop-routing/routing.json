      "borderWidth": 1.5,
      "texts": [
        {
          "text": "**App operation**",
          "fontSize": 18,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "Kit, script, app API or browser DOM. No pixels.",
          "fontSize": 15,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "**Task for an agent**",
          "fontSize": 18,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "Delegate the named job with scoped context.",
          "fontSize": 15,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "**Native control**",
          "fontSize": 18,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "Read its accessibility ref; act headlessly. No pointer.",
          "fontSize": 15,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "**Only physical input fits**",
          "fontSize": 18,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "Ask for a separate foreground grant, or hand back.",
          "fontSize": 15,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        }
      ]
    },
