          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "**Which did you mean?**",
          "fontSize": 18,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        },
        {
          "text": "Ask in Kit. Pixels cannot settle a preference.",
          "fontSize": 15,
          "color": "#21394c",
          "typeface": "clean",
          "hAlign": "center"
        }
      ]
